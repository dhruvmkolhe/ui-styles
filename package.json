{
  "name": "chameleon-ui-root",
  "private": true,
  "type": "module",
  "scripts": {
    "install-all": "npm install && cd frontend && npm install && cd ../backend && npm install && cd ../mcp-server && npm install",
    "build:mcp": "cd mcp-server && npm install && npm run build",
    "build:backend": "npm run build:mcp && cd backend && npm install",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "cd backend && npm run dev",
    "dev:mcp": "cd mcp-server && npm run dev",
    "dev": "next dev",
    "dev:all": "npx concurrently \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:mcp\"",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "build:cli": "cd cli && npm install && npm run build",
    "test:cli": "cd cli && npm test",
    "chameleon": "node cli/dist/cli.js",
    "cli:dev": "cd cli && npm run dev",
    "start": "cd backend && npm start",
    "sync:components": "cd backend && npm run sync:components",
    "install:frontend": "npm install --prefix frontend",
    "setup": "npm install --prefix frontend"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.3.6",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/parser": "8.70.1",
    "concurrently": "^9.1.0",
    "eslint": "9.39.5",
    "firebase-tools": "^14.23.0",
    "gifenc": "^1.0.3",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@upstash/redis": "^1.37.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.3.2",
    "express-validator": "^7.3.2",
    "firebase-admin": "^13.10.0",
    "framer-motion": "13.4.3",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "next-themes": "0.4.6",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.19.1",
    "rate-limit-redis": "^4.3.1",
    "razorpay": "^2.9.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "resend": "^6.9.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  }
}
