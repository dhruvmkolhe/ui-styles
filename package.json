{
  "name": "chameleon-ui-root",
  "private": true,
  "type": "module",
  "scripts": {
    "install-all": "npm install && cd frontend && npm install && cd ../backend && npm install && cd ../mcp-server && npm install",
    "build:mcp": "cd mcp-server && npm install && npm run build",
    "build:backend": "npm run build:mcp && cd backend && npm install",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "cd backend && npm run dev",
    "dev:mcp": "cd mcp-server && npm run dev",
    "dev": "next dev",
    "dev:all": "npx concurrently \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:mcp\"",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "build:cli": "cd cli && npm install && npm run build",
    "test:cli": "cd cli && npm test",
    "chameleon": "node cli/dist/cli.js",
    "cli:dev": "cd cli && npm run dev",
    "start": "cd backend && npm start",
    "sync:components": "cd backend && npm run sync:components",
    "install:frontend": "npm install --prefix frontend",
    "setup": "npm install --prefix frontend"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "firebase-tools": "^14.23.0",
    "gifenc": "^1.0.3",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@upstash/redis": "^1.37.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.3.2",
    "express-validator": "^7.3.2",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "lucide-react": "^0.469.0",
    "next": "^15.1.0",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.19.1",
    "rate-limit-redis": "^4.3.1",
    "razorpay": "^2.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.9.4",
    "tailwind-merge": "^2.5.5"
  }
}
